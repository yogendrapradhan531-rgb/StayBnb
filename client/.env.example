# Vite only exposes variables prefixed with VITE_ to the browser.
# .env.development is used by `npm run dev`, .env.production by `npm run build`.
# On Vercel/Netlify, set these in the dashboard (they override the files).

# Base URL of the Express API (must end with /api)
VITE_API_URL=/api

# ISO currency code used for prices
VITE_CURRENCY=INR
