# Copy this file to `.env` for local development.
# In production (Render etc.) set these in the dashboard instead of committing a file.

NODE_ENV=development
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/airbnb_clone

# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Currency for prices and Stripe charges (ISO code). Keep in sync with client VITE_CURRENCY.
CURRENCY=INR

# ---- Stripe (optional) ----
# Leave empty to skip payments – bookings are then confirmed instantly.
# Get TEST keys at https://dashboard.stripe.com/test/apikeys (sk_test_...)
STRIPE_SECRET_KEY=
# Only needed if you forward webhooks (stripe listen --forward-to localhost:5000/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=
# Minutes a pending booking holds its dates while the guest pays (min 30)
PAYMENT_HOLD_MINUTES=30

# ---- India / GST ----
# Set to false to turn GST off (prices then exclude tax)
GST_ENABLED=true
# Seller details printed on tax invoices. Leave PLATFORM_GSTIN empty unless you hold a real GSTIN.
PLATFORM_NAME=Staybnb (student project)
PLATFORM_ADDRESS=Bengaluru, Karnataka 560001, India
PLATFORM_GSTIN=
